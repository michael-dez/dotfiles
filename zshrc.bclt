# BCLT -- per-host shell config, linked to ~/.zshrc.local by install.yml. Counterpart to zshrc.bcpc.
# Host-specific addresses go in untracked ~/.zshrc.private (this repo is published).
[ -f ~/.zshrc.private ] && . ~/.zshrc.private

# Put bcpc's ollama on this host's 127.0.0.1:11434. Why: docs/llm.md#bclt-forward
alias ollama-forward='ssh -N -L 11434:127.0.0.1:11434 ${BCPC_SSH_HOST:-bcpc}'
