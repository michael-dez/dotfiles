# bcpc -- terminal-palette gradient across OpenRGB devices.  ->  ~/.config/systemd/user/iceberg-rgb.service
# Started from hypr/bcpc.lua, not enabled. Tune flags on ExecStart. Why: docs/rgb.md#iceberg-rgbservice
[Unit]
Description=Terminal-palette gradient across OpenRGB devices
BindsTo=openrgb-server.service
After=openrgb-server.service

[Service]
ExecStart=%h/.local/bin/iceberg-rgb --dim 0.6 --dim-at 0.5
Restart=on-failure
RestartSec=5
