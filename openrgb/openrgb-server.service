# bcpc -- OpenRGB SDK server as the logged-in user.  ->  ~/.config/systemd/user/openrgb-server.service
# No [Install]: device ACLs need an active session; hypr/bcpc.lua starts iceberg-rgb.service, which pulls this in.
# Why: docs/rgb.md#openrgb-serverservice
[Unit]
Description=OpenRGB SDK server

[Service]
ExecStart=/usr/bin/openrgb --server --noautoconnect --profile Iceberg
Restart=on-failure
RestartSec=5
