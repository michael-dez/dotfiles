# bcpc -- per-host shell config, linked to ~/.zshrc.local by install.yml. Interactive shells only;
# session-wide env lives in hypr/bcpc.lua. docs/shell.md#zshrcbcpc

# --- CUDA / local inference ---
export CUDA_HOME=/opt/cuda
export PATH="$CUDA_HOME/bin:$PATH"

# Host-specific addresses go in untracked ~/.zshrc.private (published repo).
[ -f ~/.zshrc.private ] && . ~/.zshrc.private

# gs-*, not gs (gs is `git status`). -O only applies on the DRM backend. docs/shell.md#zshrcbcpc
alias gs-fast='gamescope -W 1920 -H 1080 -r 540 -O DP-3,DP-1 -f --'
alias gs-wide='gamescope -W 3440 -H 1440 -r 180 -O DP-1,DP-3 -f --'
