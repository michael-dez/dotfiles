# bcpc -- socket-activation shim in front of ollama.  ->  /etc/systemd/system/ollama-proxy.service
# Why BindsTo, After ordering: docs/llm.md#ollama-proxyservice

[Unit]
Description=Socket activation proxy for ollama
Documentation=man:systemd-socket-proxyd(8)
Requires=ollama.socket
After=ollama.socket
BindsTo=ollama.service
After=ollama.service

[Service]
Type=notify
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:11435

User=ollama
Group=ollama
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
