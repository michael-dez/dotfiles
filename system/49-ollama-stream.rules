// bcpc -- let wheel start/stop the ollama units from the stream hooks.
//   ->  /etc/polkit-1/rules.d/49-ollama-stream.rules
// Check `journalctl -u polkit -n 20` after edits. Why scoped so: docs/llm.md#polkit-rule
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units") {
        return;
    }
    if (!subject.isInGroup("wheel")) {
        return;
    }

    var unit = action.lookup("unit");
    var verb = action.lookup("verb");

    var units = ["ollama.service", "ollama.socket", "ollama-proxy.service"];
    var verbs = ["start", "stop", "restart"];

    if (units.indexOf(unit) !== -1 && verbs.indexOf(verb) !== -1) {
        return polkit.Result.YES;
    }
});
