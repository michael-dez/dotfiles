# bcpc -- loopback listener that starts ollama on demand.  ->  /etc/systemd/system/ollama.socket
# Loopback only: ollama has no auth and this box has no firewall.
# [Install] kept on purpose. Why: docs/llm.md#ollamasocket

[Unit]
Description=Ollama on-demand listener
Documentation=man:systemd-socket-proxyd(8)

[Socket]
ListenStream=127.0.0.1:11434
ListenStream=[::1]:11434
Service=ollama-proxy.service

[Install]
WantedBy=sockets.target
