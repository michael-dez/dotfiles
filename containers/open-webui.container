# bcpc / BCLT -- Open WebUI, local, loopback only.  ->  ~/.config/containers/systemd/open-webui.container
# Start on demand: systemctl --user start open-webui. No [Install] on purpose.
# Why (Network=host, HOST, oom-score-adj, no WEBUI_AUTH=False): docs/llm.md#containers

[Unit]
Description=Open WebUI (localhost only, backed by the local ollama)
After=network-online.target

[Container]
Image=ghcr.io/open-webui/open-webui:main
Network=host

Environment=HOST=127.0.0.1
Environment=PORT=8080

Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434

Volume=%h/.local/share/open-webui:/app/backend/data

PodmanArgs=--oom-score-adj=450

AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=900
