# bcpc / BCLT -- Langflow, run locally alongside Open WebUI.
#   ->  ~/.config/containers/systemd/langflow.container
#
# Same shape as open-webui.container, and the reasoning in that file's header
# applies here unchanged: quadlet rather than a hand-written unit, started on
# demand rather than enabled, Network=host so that 127.0.0.1:11434 means the
# host's ollama, and an explicit bind address because host networking would
# otherwise put this on every interface of a machine with no firewall.
#
# Worth knowing before the first start: this image is several times the size of
# Open WebUI's and takes correspondingly longer to pull, and Langflow's first
# run initialises a SQLite database under the volume below before the UI
# answers. `systemctl --user start langflow` returning is not the same as the
# UI being ready -- give it a minute and watch `podman logs -f langflow`.

[Unit]
Description=Langflow (localhost only, backed by the local ollama)
After=network-online.target

[Container]
Image=docker.io/langflowai/langflow:latest
Network=host

# Langflow reads both of these directly; the defaults are 0.0.0.0:7860.
Environment=LANGFLOW_HOST=127.0.0.1
Environment=LANGFLOW_PORT=7860

# Flows, the SQLite database and cached components. Pointed at the mount below
# rather than the image's default ~/.langflow, so nothing of value lives in the
# container's own writable layer where a `podman rm` would take it.
Environment=LANGFLOW_CONFIG_DIR=/var/lib/langflow
Volume=%h/.local/share/langflow:/var/lib/langflow

# In a flow's Ollama component, the base URL to use is http://127.0.0.1:11434 --
# the same address the UI on either machine uses, for the same reason.

# Memory pressure ranking -- same value, same reason and deliberately the same
# mechanism as containers/open-webui.container, even though this image does
# rename its process to `langflow` and so could have been matched by earlyoom's
# --prefer regex instead. AutoUpdate=registry on a :latest tag means that
# process name is not a stable interface; oom_score_adj is.
PodmanArgs=--oom-score-adj=450

AutoUpdate=registry

[Service]
Restart=on-failure
# Longer than Open WebUI's: this image is the larger pull of the two.
TimeoutStartSec=1800

# --- deliberately no [Install] section ---------------------------------------
# The header above says this is "started on demand rather than enabled", and
# until now that was simply untrue: `[Install] WantedBy=default.target` is
# exactly what makes it not on-demand. The quadlet generator turns that line
# into
#
#     /run/user/1000/systemd/generator/default.target.wants/langflow.service
#
# at every daemon-reload, so the unit started at login on both machines and
# nothing in roles/llm/ had to call `systemctl --user enable` for it to happen.
# Removing the section removes that symlink; `systemctl --user start langflow`
# is unaffected, which is the whole intent.
#
# It was not harmless. Restart=on-failure above plus a container that exits
# non-zero is a crash loop, and this one ran 217 restarts in a six-hour session
# -- each one a registry check against docker.io, a container create and an
# overlayfs mount, all while a game was running. The restart policy is still
# right for a container you started on purpose; it is only dangerous on one
# that starts itself at login and fails there unattended.
#
# Note that containers/open-webui.container carries the same contradiction and
# is left alone on purpose: it is wanted at login on these hosts and it does
# not fail there. If that ever changes, this is the fix.
