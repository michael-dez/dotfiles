# bcpc / BCLT -- Langflow, local, loopback only.  ->  ~/.config/containers/systemd/langflow.container
# Start on demand: systemctl --user start langflow. No [Install] on purpose.
# Same shape as open-webui.container. Why: docs/llm.md#containers

[Unit]
Description=Langflow (localhost only, backed by the local ollama)
After=network-online.target

[Container]
Image=docker.io/langflowai/langflow:latest
Network=host

Environment=LANGFLOW_HOST=127.0.0.1
Environment=LANGFLOW_PORT=7860

Environment=LANGFLOW_CONFIG_DIR=/var/lib/langflow
Volume=%h/.local/share/langflow:/var/lib/langflow

PodmanArgs=--oom-score-adj=450

AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=1800
